<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">사운드 딜레이</string>

    <string name="instructions">TV 화면과 스마트폰 소리의 싱크를 맞추기 위해, 폰에서 재생 중인 오디오를 설정한 시간만큼 늦게 다시 들려줍니다.\n\n1. 블루투스 이어폰을 연결하세요.\n2. 지연 시간을 설정하고 시작을 누르세요.\n3. 화면 캡처 허용 창이 뜨면 허용하세요. 소리만 사용하며 화면은 녹화·저장하지 않습니다.\n4. 미디어 볼륨을 0으로 낮춰 원본 소리를 끄세요. 지연된 소리의 크기는 알람 볼륨으로 조절합니다.\n\n※ 넷플릭스 등 오디오 캡처를 차단하는 앱은 지원되지 않습니다. (유튜브는 가능)</string>

    <string name="delay_label">지연 시간 (0.5초 ~ 20초)</string>
    <string name="delay_value_format">%.1f초</string>
    <string name="minus_01">−0.1초</string>
    <string name="plus_01">+0.1초</string>

    <string name="output_label">출력 볼륨 채널</string>
    <string name="output_hint">지연된 소리를 내보낼 볼륨 채널입니다. 원본(미디어 볼륨)을 0으로 두어도 들리도록 기본값은 알람 볼륨입니다. 기기에 따라 알람이 스피커로도 울리면 다른 채널로 바꿔 보세요.</string>
    <string-array name="output_options">
        <item>알람 볼륨 (권장)</item>
        <item>미디어 볼륨</item>
        <item>접근성 볼륨</item>
    </string-array>

    <string name="start">시작</string>
    <string name="stop">정지</string>
    <string name="status_idle">대기 중</string>
    <string name="status_starting">시작하는 중…</string>
    <string name="status_running">딜레이 재생 중 — 미디어 볼륨을 0으로 낮추세요</string>
    <string name="status_error">오류: %s</string>

    <string name="error_record_permission">오디오 캡처를 위해 마이크 권한이 필요합니다</string>
    <string name="error_projection_denied">화면 캡처 권한이 없어 시작할 수 없습니다</string>
    <string name="error_capture_stopped">오디오 캡처가 중단되었습니다</string>
    <string name="error_start_failed">시작에 실패했습니다</string>

    <string name="notification_channel_name">딜레이 서비스</string>
    <string name="notification_title">사운드 딜레이 실행 중</string>
    <string name="notification_text">재생 오디오를 지연시켜 출력하고 있습니다</string>
</resources>
